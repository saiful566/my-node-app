# Node.js v24 এর অফিসিয়াল ইমেজ ব্যবহার করা হচ্ছে
FROM node:24-slim

# কন্টেইনারের ভেতরের ওয়ার্কিং ডিরেক্টরি
WORKDIR /usr/src/app

# ডিপেন্ডেন্সি ফাইল কপি করা
COPY package*.json ./

# প্যাকেজ ইনস্টল করা
RUN npm install

# প্রজেক্টের বাকি সব ফাইল কপি করা
COPY . .

# পোর্ট এক্সপোজ করা
EXPOSE 3000

# প্রজেক্ট চালু করার কমান্ড
CMD ["npm", "start"]
